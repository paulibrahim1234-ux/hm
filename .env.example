# ============================================
# 她在 AI Companion - 环境变量配置
# 上线前请将此文件复制为 .env 并填入真实值
# ============================================

# === 数据库 (Neon / Supabase / 其他 PostgreSQL) ===
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# === OpenAI-compatible LLM 聊天 ===
# 获取: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxx"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# 推荐聊天模型: sao10k/l3.3-euryale-70b；备选: deepseek/deepseek-v3.2 或 z-ai/glm-4.5-air
LLM_MODEL="sao10k/l3.3-euryale-70b"
# OpenClaw/host shells may export LLM_MODEL globally. When using OpenRouter,
# this app prefers OPENROUTER_MODEL so the mistress chat does not fall back to a generic OpenAI model.
OPENROUTER_MODEL="sao10k/l3.3-euryale-70b"
# 也可直接配置任意 OpenAI-compatible 服务（例如本地 LM Studio/vLLM/llama.cpp 网关）。
# LLM_API_KEY 优先级高于 OPENROUTER_API_KEY / OPENAI_API_KEY；LLM_BASE_URL 优先级高于 OPENROUTER_BASE_URL。
LLM_API_KEY=""
LLM_BASE_URL=""

# === MiniMax - 图片生成 & TTS 语音 ===
# 获取: https://platform.minimaxi.com
# 如果不需要图片/语音功能，可以留空
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimaxi.com/v1"

# === 成人媒体 / 视频生成 (可选) ===
# 设为 false 可在服务端强制关闭成人媒体模式；默认允许前端开关。
ADULT_MEDIA_ENABLED="true"
# fal 使用 fal.ai Nano Banana 2；auto 会尝试 OpenAI 图片、fal，最后回退 Pollinations。
IMAGE_PROVIDER="fal"
IMAGE_MODEL="fal-ai/nano-banana-2"
FAL_KEY=""
FAL_IMAGE_MODEL="fal-ai/nano-banana-2"
FAL_IMAGE_ASPECT_RATIO="9:16"
FAL_IMAGE_RESOLUTION="1K"
FAL_IMAGE_SAFETY_TOLERANCE="6"
# 接入任意返回 videoUrl/video_url/url 的文生视频服务。
VIDEO_GENERATION_ENDPOINT=""
VIDEO_GENERATION_API_KEY=""
VIDEO_GENERATION_MODEL=""

# === Cloudflare R2 (可选，用于持久化生成图片) ===
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# === 认证 ===
JWT_SECRET="生成一个强随机字符串-至少32字符"
BETTER_AUTH_SECRET="生成另一个强随机字符串-至少32字符"
# 生产环境必须使用公开访问的主域名，Google OAuth 回调也要使用同一个域名
BETTER_AUTH_URL="https://www.dreamgf.online"
AUTH_CANONICAL_URL="https://www.dreamgf.online"

# === Google OAuth (可选) ===
# 获取: https://console.cloud.google.com → OAuth 2.0 凭证
# Redirect URI: https://www.dreamgf.online/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === GitHub OAuth (可选) ===
# 获取: https://github.com/settings/developers → OAuth App
# Callback URL: https://your-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# === Creem 支付 (可选) ===
# 开发测试模式: https://docs.creem.io/getting-started/test-mode
# API Key / Webhook Secret: Dashboard -> Developers
CREEM_API_KEY="creem_test_xxx"
# 测试模式使用 https://test-api.creem.io，正式环境使用 https://api.creem.io
CREEM_BASE_URL="https://test-api.creem.io"
CREEM_WEBHOOK_SECRET=""

# 兼容旧的单一订阅商品配置；建议改为下面的细分商品 ID
CREEM_PRODUCT_ID=""

# 在 Creem Dashboard 创建商品后填入 Product ID
CREEM_PLUS_PRODUCT_ID=""
CREEM_PRO_PRODUCT_ID=""
CREEM_CREDITS_50_PRODUCT_ID=""
CREEM_CREDITS_200_PRODUCT_ID=""
CREEM_CREDITS_500_PRODUCT_ID=""

# === Telegram Bot (可选) ===
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# === QQ Bot (可选) ===
NEXT_PUBLIC_QQ_BOT_ID=""

# === Vercel Cron (可选) ===
CRON_SECRET="生成一个随机字符串用于保护cron端点"

# === 应用 ===
NEXT_PUBLIC_APP_NAME="她在"

# === 疗愈模式 ===
# Pro 专属功能；默认限时开放给所有用户。设为 false 后只允许 Pro 使用。
HEALING_FREE_TRIAL_OPEN="true"
